# Production target: dedicated Ubuntu 24.04 x86_64 Vultr VM, Docker Engine 28+.
# Point both A records to this VM; open TCP80/443/8443 in the Vultr firewall.
APP_DOMAIN=brz.example.com
DEMO_DOMAIN=demo.example.com
ACME_EMAIL=you@example.com
# Real public IPv4 of the VM. Browser tasks remain disabled while empty/invalid.
DEMO_IP=
EGRESS_DNS=1.1.1.1
BROWSER_DOMAINS=news.ycombinator.com

# Presets use real sandboxes with no model requests; custom AI starts disabled.
AI_ENABLED=false
VULTR_API_KEY=
VULTR_TEXT_MODEL=
VULTR_VISION_MODEL=

REDIS_URL=redis://redis:6379/0
PYTHON_IMAGE=brz-python-sandbox:local
BROWSER_IMAGE=brz-browser-sandbox:local
PROXY_IMAGE=brz-egress-proxy:local
# Review/update this pin when Ubuntu publishes a security update; never silently
# switch to a different package or remove pinning to make an unavailable build pass.
SQUID_VERSION=6.14-0ubuntu0.24.04.5

# Native MCP engine (optional). Requires an mcp-stdio binary built with Rust 1.98.0.
NATIVE_MODE=stdio
NATIVE_BINARY_PATH=
NATIVE_DATABASE_PATH=
